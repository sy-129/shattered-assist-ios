<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23094" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="assist-launch">
    <device id="retina6_12" orientation="landscape" appearance="dark"/>
    <dependencies><deployment identifier="iOS"/><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23084"/><capability name="Safe area layout guides" minToolsVersion="9.0"/></dependencies>
    <scenes><scene sceneID="assist-scene"><objects>
        <viewController id="assist-launch" sceneMemberID="viewController"><view key="view" contentMode="scaleToFill" id="assist-view">
            <rect key="frame" x="0" y="0" width="852" height="393"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews><imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="AssistLogo" translatesAutoresizingMaskIntoConstraints="NO" id="assist-logo"><rect key="frame" x="64" y="16" width="724" height="361"/></imageView></subviews>
            <viewLayoutGuide key="safeArea" id="assist-safe"/>
            <color key="backgroundColor" red="0.035" green="0.045" blue="0.035" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
            <constraints>
                <constraint firstItem="assist-logo" firstAttribute="leading" secondItem="assist-safe" secondAttribute="leading" constant="16" id="assist-left"/>
                <constraint firstItem="assist-safe" firstAttribute="trailing" secondItem="assist-logo" secondAttribute="trailing" constant="16" id="assist-right"/>
                <constraint firstItem="assist-logo" firstAttribute="top" secondItem="assist-safe" secondAttribute="top" constant="16" id="assist-top"/>
                <constraint firstItem="assist-safe" firstAttribute="bottom" secondItem="assist-logo" secondAttribute="bottom" constant="16" id="assist-bottom"/>
            </constraints>
        </view></viewController><placeholder placeholderIdentifier="IBFirstResponder" id="assist-responder" sceneMemberID="firstResponder"/>
    </objects></scene></scenes><resources><image name="AssistLogo" width="1254" height="1254"/></resources>
